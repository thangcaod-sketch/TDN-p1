    if (raw) state.progress = JSON.parse(raw);
  } catch (e) { console.warn("Load failed", e); }
  if (!state.progress.fcStats) state.progress.fcStats = {};
  if (!state.progress.history) state.progress.history = [];
}
function saveProgress() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state.progress)); } catch (e) {}
}

function srsUpdate(stat, isCorrect) {
  const s = { ease: 2.5, interval: 0, ...stat };
  if (isCorrect) {
    s.ease = Math.min(3.0, s.ease + 0.05);
    s.interval = s.interval === 0 ? 1 : (s.interval < 1 ? 1 : Math.round(s.interval * s.ease));
  } else {
    s.ease = Math.max(1.3, s.ease - 0.25);
    s.interval = 0.25;
  }
  s.dueAt = Date.now() + s.interval * DAY;
  return s;
}

function recordAnswer(qId, isCorrect, durationMs) {
  const cur = state.progress.qStats[qId] || { seen: 0, correct: 0, wrong: 0, totalMs: 0 };
  const updated = {
    ...cur,
    seen: cur.seen + 1,
    correct: cur.correct + (isCorrect ? 1 : 0),
    wrong: cur.wrong + (isCorrect ? 0 : 1),
    totalMs: cur.totalMs + durationMs,
    lastMs: durationMs,
    lastCorrect: isCorrect,
    lastAt: Date.now(),
  };
  Object.assign(updated, srsUpdate({ ease: cur.ease, interval: cur.interval }, isCorrect));
  state.progress.qStats[qId] = updated;
  saveProgress();
}

function recordFlashcard(fcId, rating) {
  // rating: again, hard, good, easy
  const cur = state.progress.fcStats[fcId] || { seen: 0, ease: 2.5, interval: 0 };
  const isCorrect = rating !== "again";
  const map = { again: -0.3, hard: -0.05, good: 0.05, easy: 0.15 };
  cur.ease = Math.max(1.3, Math.min(3.0, cur.ease + map[rating]));
  if (rating === "again") cur.interval = 0.25;
  else if (rating === "hard") cur.interval = Math.max(1, cur.interval * 1.2);
  else if (rating === "good") cur.interval = cur.interval === 0 ? 1 : cur.interval * cur.ease;
  else if (rating === "easy") cur.interval = cur.interval === 0 ? 3 : cur.interval * cur.ease * 1.3;
  cur.interval = Math.round(cur.interval * 100) / 100;
  cur.dueAt = Date.now() + cur.interval * DAY;
  cur.seen += 1;
  cur.lastRating = rating;
  cur.lastAt = Date.now();
  state.progress.fcStats[fcId] = cur;
  saveProgress();
}

function recordSession(session) {
  state.progress.history = [session, ...(state.progress.history || [])].slice(0, 50);
