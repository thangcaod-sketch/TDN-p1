function answerableQuestions(subject) {
  return QUESTIONS.filter(q => q.s === subject && q.c);
}

function computeSubjectStats(subject) {
  const subjectQs = answerableQuestions(subject);
  const total = subjectQs.length;
  let seen = 0, correct = 0, wrong = 0, totalMs = 0, mastered = 0, dueNow = 0;
  const now = Date.now();
  for (const q of subjectQs) {
    const s = state.progress.qStats[q.id];
    if (!s) continue;
    seen += 1;
    correct += s.correct; wrong += s.wrong; totalMs += s.totalMs;
    const ratio = s.correct / Math.max(1, s.correct + s.wrong);
    if (s.seen >= 2 && ratio >= 0.8) mastered += 1;
    if (s.dueAt && s.dueAt <= now) dueNow += 1;
  }
  const totalAns = correct + wrong;
  return {
    total, seen, correct, wrong, mastered, dueNow,
    accuracy: totalAns > 0 ? correct / totalAns : 0,
    avgSec: totalAns > 0 ? totalMs / 1000 / totalAns : 0,
    masteryPct: total > 0 ? mastered / total : 0,
  };
}

function weakQuestions(subject) {
  return QUESTIONS.filter(q => {
    if (!q.c) return false;
    if (subject && q.s !== subject) return false;
    const s = state.progress.qStats[q.id];
    if (!s || s.seen === 0) return false;
    const ratio = s.correct / Math.max(1, s.correct + s.wrong);
    return ratio < 0.6 || s.lastCorrect === false;
  }).sort((a, b) => state.progress.qStats[b.id].wrong - state.progress.qStats[a.id].wrong);
}

function dueQuestions(subject) {
  const now = Date.now();
  return QUESTIONS.filter(q => {
    if (!q.c) return false;
    if (subject && q.s !== subject) return false;
    const s = state.progress.qStats[q.id];
    if (!s) return true;
    return !s.dueAt || s.dueAt <= now;
  });
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function pickQuestionsForMode(mode, subject) {
  if (mode === "weak") return shuffle(weakQuestions(subject));
  if (mode === "srs") {
    let pool = dueQuestions(subject);
    if (pool.length === 0) pool = answerableQuestions(subject);
    return shuffle(pool);
  }
  if (mode === "test") return shuffle(answerableQuestions(subject)).slice(0, 10);
  if (mode === "boss") return shuffle(answerableQuestions(subject));
  // practice
  const all = answerableQuestions(subject);
  const unseen = all.filter(q => !state.progress.qStats[q.id]);
  const seen = all.filter(q => state.progress.qStats[q.id]);
  return [...shuffle(unseen), ...shuffle(seen)];
}

function fmtPct(n) { return Math.round(n * 100) + "%"; }
function fmtSec(n) { return n < 10 ? n.toFixed(1) + "s" : Math.round(n) + "s"; }
function fmtTime(ts) {
  const d = new Date(ts);
  return d.toLocaleDateString("vi-VN") + " " + d.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

