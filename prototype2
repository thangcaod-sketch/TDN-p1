        </div>
        <div class="detail-time">${(a.timeMs/1000).toFixed(1)}s</div>
      </div>
    `;
  }).join("");
  
  return `
    <div class="result-hero">
      <div class="result-eyebrow">Kết quả phiên luyện tập</div>
      <div class="result-score" style="color:${info.color}">${session.correct}<span class="result-score-of"> / ${session.total}</span></div>
      <div class="result-verdict">${verdict}</div>
    </div>
    <div class="overview-grid">
      <div class="card"><div class="ov-label">Chính xác</div><div class="ov-value">${fmtPct(pct)}</div><div class="ov-sub" style="color:${info.color}">&nbsp;</div></div>
      <div class="card"><div class="ov-label">Thời gian</div><div class="ov-value">${minutes}p</div><div class="ov-sub" style="color:#3D4F8C">&nbsp;</div></div>
      <div class="card"><div class="ov-label">Trung bình</div><div class="ov-value">${avgSec}s</div><div class="ov-sub" style="color:#B8552E">mỗi câu</div></div>
    </div>
    <div class="card" style="margin-bottom:24px">
      <h3 style="font-family:Fraunces,serif;font-size:20px;font-weight:600;margin-bottom:12px">Chi tiết</h3>
      <div class="detail-list">${rows}</div>
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <button class="btn-primary" style="background:${info.color}" data-action="subject" data-subject="${session.subject}">Luyện tiếp →</button>
      <button class="btn-ghost" data-action="home">Về trang chủ</button>
    </div>
  `;
}

