<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg: #F7F3EA;
  --card: #FCFAF4;
  --ink: #1F1A14;
  --muted: #7A6856;
  --soft-muted: #5C4A3D;
  --border: rgba(120,90,60,0.12);
  --border-strong: rgba(120,90,60,0.18);
  --accent: #B8552E;
  --green: #2D5A4F;
  --green-soft: #E4EDE9;
  --red: #B8552E;
  --red-soft: #F4DDD5;
  --blue: #3D4F8C;
  --gold: #9B6B1E;
}
html, body { background: var(--bg); color: var(--ink); font-family: 'DM Sans', system-ui, sans-serif; min-height: 100vh; }
body { background-image: radial-gradient(rgba(60,40,20,0.025) 1px, transparent 1px); background-size: 3px 3px; }
.serif { font-family: 'Fraunces', Georgia, serif; }
.italic-display { font-style: italic; }
.num { font-variant-numeric: tabular-nums; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
button:disabled { cursor: not-allowed; }

.container { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

/* Header */
header.app-header { padding: 40px 0 32px; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; }
.brand { text-align: left; }
.brand-title { font-family: 'Fraunces', serif; font-size: clamp(28px, 4vw, 38px); font-weight: 600; font-style: italic; letter-spacing: -0.01em; }
.brand-title .accent { color: var(--accent); }
.brand-sub { font-size: 11px; text-transform: uppercase; letter-spacing: 0.25em; color: var(--muted); margin-top: 4px; }
.nav-link { font-size: 14px; color: var(--soft-muted); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
.nav-link:hover { color: var(--ink); }

/* Cards */
.card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 20px; box-shadow: 0 1px 0 rgba(120,90,60,0.06), 0 8px 22px -14px rgba(80,50,20,0.16); transition: transform 0.25s cubic-bezier(.2,.7,.3,1), box-shadow 0.25s; }
.card.lift { cursor: pointer; }
.card.lift:hover { transform: translateY(-2px); box-shadow: 0 4px 0 rgba(120,90,60,0.04), 0 16px 30px -14px rgba(80,50,20,0.22); }
.card.disabled { opacity: 0.5; cursor: not-allowed; }
.card.big { padding: 28px; }

/* Overview row */
.overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 40px; }
@media (max-width: 700px) { .overview-grid { grid-template-columns: 1fr; } }
.ov-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: var(--muted); }
.ov-value { font-family: 'Fraunces', serif; font-size: 44px; font-weight: 600; line-height: 1; margin: 8px 0 4px; font-variant-numeric: tabular-nums; }
.ov-value.big { font-size: 52px; }
.ov-sub { font-size: 13px; color: var(--accent); }

/* Section title */
.section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 20px; }
.section-title h2 { font-family: 'Fraunces', serif; font-size: 26px; font-weight: 600; }
.section-meta { font-size: 11px; text-transform: uppercase; letter-spacing: 0.25em; color: var(--muted); }

/* Subject grid */
.subject-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
@media (max-width: 900px) { .subject-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .subject-grid { grid-template-columns: 1fr; } }
.subject-card { display: block; width: 100%; text-align: left; }
.sc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
.sc-icon { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-weight: 600; font-size: 18px; flex-shrink: 0; }
.sc-info { flex: 1; }
.sc-title { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; }
.sc-meta { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-top: 2px; }
.sc-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-top: 14px; border-top: 1px solid var(--border); }
.stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
.stat-value { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
.due-indicator { margin-top: 12px; font-size: 12px; display: flex; align-items: center; gap: 6px; }
.due-dot { width: 6px; height: 6px; border-radius: 50%; }

/* Mastery ring */
.ring { position: relative; }
.ring svg { transform: rotate(-90deg); }
.ring-circle-bg { fill: none; stroke: rgba(120,90,60,0.15); stroke-width: 4; }
.ring-circle-fg { fill: none; stroke-width: 4; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
.ring-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-weight: 600; font-size: 14px; font-variant-numeric: tabular-nums; }

/* Action cards (home bottom) */
.action-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
@media (max-width: 700px) { .action-grid { grid-template-columns: 1fr; } }
.action-card { display: flex; align-items: center; gap: 16px; padding: 20px; }
.action-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-weight: 600; font-size: 22px; flex-shrink: 0; }
.action-text { flex: 1; }
.action-title { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 600; }
.action-sub { font-size: 13px; color: var(--muted); }
.action-arrow { font-size: 22px; }

/* Subject header */
.subject-header { padding: 32px; border-radius: 24px; margin-bottom: 32px; box-shadow: 0 1px 0 rgba(120,90,60,0.06), 0 8px 22px -14px rgba(80,50,20,0.16); }
.sh-flex { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; }
.sh-eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.25em; margin-bottom: 8px; }
.sh-title { font-family: 'Fraunces', serif; font-size: 44px; font-weight: 600; margin-bottom: 12px; }
.sh-stats { display: flex; gap: 24px; font-size: 14px; color: var(--soft-muted); flex-wrap: wrap; }
.sh-stats b { font-variant-numeric: tabular-nums; }

/* Mode cards */
.mode-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
@media (max-width: 700px) { .mode-grid { grid-template-columns: 1fr; } }
.mode-card { position: relative; }
.mode-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; gap: 8px; }
.mode-title { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; }
.mode-badge { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 10px; border-radius: 999px; font-weight: 600; white-space: nowrap; }
.mode-desc { font-size: 14px; line-height: 1.5; color: var(--soft-muted); margin-bottom: 16px; min-height: 44px; }
.mode-btn { padding: 9px 18px; border-radius: 10px; font-size: 14px; font-weight: 500; color: #FCFAF4; }
.mode-btn:disabled { color: var(--muted); background: rgba(0,0,0,0.06) !important; }

/* Quiz */
.quiz-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; gap: 16px; flex-wrap: wrap; }
.quiz-tags { display: flex; gap: 10px; align-items: center; }
.tag { font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; padding: 4px 10px; border-radius: 6px; font-weight: 600; }
.tag-muted { color: var(--muted); padding: 0; background: transparent; letter-spacing: 0.15em; }
.timer { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; font-variant-numeric: tabular-nums; }
.quiz-counter { font-size: 14px; color: var(--soft-muted); font-variant-numeric: tabular-nums; }
.progress-bar { height: 4px; background: rgba(120,90,60,0.15); border-radius: 4px; overflow: hidden; margin-bottom: 32px; }
.progress-fill { height: 100%; transition: width 0.4s ease; }

.question-card { background: var(--card); border: 1px solid var(--border); border-radius: 22px; padding: 32px; margin-bottom: 20px; box-shadow: 0 1px 0 rgba(120,90,60,0.06), 0 8px 22px -14px rgba(80,50,20,0.16); }
.q-eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.25em; color: var(--muted); margin-bottom: 10px; }
.q-text { font-family: 'Fraunces', serif; font-size: clamp(20px, 2.6vw, 28px); font-weight: 500; line-height: 1.35; }
.q-image-desc { margin-top: 16px; padding: 14px 16px; border-radius: 12px; font-size: 13px; font-style: italic; }
.q-note { margin-top: 8px; font-size: 13px; font-style: italic; color: var(--muted); }
.img-search-btn {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: 18px; padding: 8px 14px;
  background: rgba(60, 79, 140, 0.08);
  color: var(--blue);
  border-radius: 999px;
  font-size: 13px; font-weight: 500;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s;
  border: 1px solid rgba(60, 79, 140, 0.18);
}
.img-search-btn:hover {
  background: rgba(60, 79, 140, 0.14);
  transform: translateY(-1px);
}
.img-search-btn span { font-size: 14px; }

.options-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
@media (max-width: 600px) { .options-grid { grid-template-columns: 1fr; } }
.option { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border-radius: 14px; text-align: left; width: 100%; background: var(--card); border: 1px solid var(--border-strong); transition: transform 0.18s, background 0.18s, border-color 0.18s; }
.option:not(:disabled):hover { transform: translateY(-1px); }
.option-letter { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-weight: 600; flex-shrink: 0; background: rgba(120,90,60,0.1); color: var(--soft-muted); }
.option-text { flex: 1; line-height: 1.4; }
.option-note { font-size: 12px; font-style: italic; opacity: 0.75; margin-top: 3px; }
.option-mark { font-size: 20px; }
.option.selected { background: var(--card); border-color: var(--accent); }
.option.selected .option-letter { background: var(--accent); color: #fff; }
.option.correct { background: var(--green-soft); border-color: var(--green); color: var(--green); }
.option.correct .option-letter { background: var(--green); color: #fff; }
.option.wrong { background: var(--red-soft); border-color: var(--red); color: #8B3D24; }
.option.wrong .option-letter { background: var(--red); color: #fff; }
.option.dim { opacity: 0.5; }

.feedback { margin-top: 24px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
.feedback-text { flex: 1; }
.feedback-title { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; }
.feedback-sub { font-size: 13px; color: var(--soft-muted); margin-top: 4px; }
.btn-primary { padding: 11px 22px; border-radius: 12px; font-weight: 500; color: #FCFAF4; font-size: 14px; }

/* Result view */
.result-hero { text-align: center; padding: 32px 0; }
.result-eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.25em; color: var(--muted); margin-bottom: 12px; }
.result-score { font-family: 'Fraunces', serif; font-size: 80px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; margin-bottom: 8px; }
.result-score-of { font-size: 0.4em; font-weight: 400; color: var(--muted); }
.result-verdict { font-family: 'Fraunces', serif; font-style: italic; font-size: 26px; }
.detail-list { padding: 0; }
.detail-row { display: flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid rgba(120,90,60,0.08); }
.detail-row:last-child { border-bottom: none; }
.detail-icon { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; flex-shrink: 0; }
.detail-row .detail-text { flex: 1; font-size: 14px; line-height: 1.4; }
.detail-row .detail-time { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
.detail-meta { font-size: 12px; color: var(--muted); margin-top: 4px; }

/* Boss mode */
.boss-stage { text-align: center; padding: 24px 0; }
.boss-streak { font-family: 'Fraunces', serif; font-size: 120px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
.boss-streak-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.25em; color: var(--muted); margin-top: 8px; }
.boss-target { font-family: 'Fraunces', serif; font-size: 16px; font-style: italic; color: var(--muted); margin-top: 4px; }
.boss-lives { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
.boss-heart { font-size: 24px; transition: opacity 0.3s; }
.boss-heart.lost { opacity: 0.2; }

/* Flashcards */
.fc-topic-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
@media (max-width: 600px) { .fc-topic-grid { grid-template-columns: 1fr; } }
.fc-topic { padding: 18px; }
.fc-topic-title { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 600; }
.fc-topic-meta { font-size: 13px; color: var(--muted); margin-top: 4px; }
.fc-stage { padding: 32px 0; }
.fc-card { background: var(--card); border: 1px solid var(--border); border-radius: 24px; padding: 60px 40px; text-align: center; min-height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 1px 0 rgba(120,90,60,0.06), 0 8px 22px -14px rgba(80,50,20,0.16); margin: 24px 0; cursor: pointer; transition: transform 0.2s; }
.fc-card:hover { transform: translateY(-2px); }
.fc-front { font-family: 'Fraunces', serif; font-size: clamp(28px, 5vw, 42px); font-weight: 600; }
.fc-back { font-family: 'Fraunces', serif; font-size: clamp(24px, 4vw, 36px); font-style: italic; color: var(--accent); }
.fc-hint { font-size: 12px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted); margin-top: 16px; }
.fc-rate { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 16px; }
@media (max-width: 600px) { .fc-rate { grid-template-columns: repeat(2, 1fr); } }
.fc-rate-btn { padding: 12px 8px; border-radius: 10px; font-size: 13px; font-weight: 500; border: 1px solid var(--border-strong); }
.fc-rate-btn:hover { transform: translateY(-1px); }

/* Weak / Stats lists */
.list-row { padding: 14px 18px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; display: flex; gap: 14px; align-items: flex-start; }
.lr-info { flex: 1; }
.lr-meta { font-size: 11px; color: var(--muted); margin-bottom: 3px; }
.lr-q { font-size: 14px; line-height: 1.4; margin-bottom: 8px; }
.lr-stats { font-size: 12px; }

/* Buttons */
.btn-ghost { padding: 11px 22px; border-radius: 12px; background: var(--card); color: var(--ink); border: 1px solid var(--border-strong); font-size: 14px; font-weight: 500; }
.btn-ghost:hover { background: rgba(0,0,0,0.02); }

main { padding-bottom: 80px; }

/* Animations */
.fade-in { animation: fadeIn 0.4s ease both; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.empty-state { text-align: center; padding: 60px 0; }
.empty-state h3 { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; margin-bottom: 10px; }
.empty-state p { color: var(--soft-muted); margin-bottom: 20px; }

/* Modal */
.modal-overlay { position: fixed; inset: 0; background: rgba(31,26,20,0.55); display: flex; align-items: center; justify-content: center; padding: 20px; z-index: 100; animation: fadeIn 0.2s; }
.modal { background: var(--card); border-radius: 20px; padding: 28px; max-width: 440px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
.modal h3 { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; margin-bottom: 8px; }
.modal p { color: var(--soft-muted); margin-bottom: 20px; line-height: 1.5; }
.modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
.boss-config { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 16px 0; }
.boss-opt { padding: 14px 8px; border-radius: 10px; background: var(--card); border: 1.5px solid var(--border-strong); font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; text-align: center; transition: all 0.2s; }
.boss-opt.active { border-color: var(--accent); background: var(--red-soft); color: var(--accent); }
.boss-opt-label { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; font-family: 'DM Sans'; font-weight: 500; color: var(--muted); margin-top: 4px; }
.boss-opt.active .boss-opt-label { color: var(--accent); }
</style>
</head>
