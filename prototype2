function masteryRing(pct, color, size) {
  size = size || 56;
  const r = (size - 8) / 2;
  const c = 2 * Math.PI * r;
  const offset = c * (1 - pct);
  return `<div class="ring" style="width:${size}px;height:${size}px">
    <svg width="${size}" height="${size}">
      <circle class="ring-circle-bg" cx="${size/2}" cy="${size/2}" r="${r}"/>
      <circle class="ring-circle-fg" cx="${size/2}" cy="${size/2}" r="${r}" stroke="${color}" stroke-dasharray="${c}" stroke-dashoffset="${offset}"/>
    </svg>
    <div class="ring-label" style="color:${color}">${fmtPct(pct)}</div>
  </div>`;
}

function renderHome() {
  // Overall
  let totCorrect = 0, totWrong = 0, totMs = 0, totMastered = 0, totQ = 0;
  for (const subjKey of Object.keys(SUBJECTS)) {
    const st = computeSubjectStats(subjKey);
    totCorrect += st.correct; totWrong += st.wrong; totMastered += st.mastered; totQ += st.total;
  }
  const totalAns = totCorrect + totWrong;
  for (const id in state.progress.qStats) totMs += state.progress.qStats[id].totalMs || 0;
  const accuracy = totalAns > 0 ? totCorrect / totalAns : 0;
  const avgSec = totalAns > 0 ? totMs / 1000 / totalAns : 0;
  
  const weakCount = weakQuestions(null).length;
