// Build smart Google Images search URL for a question
function imgSearchUrl(q) {
  const correctOpt = q.o.find(o => o[0] === q.c);
  const answerText = correctOpt ? correctOpt[1] : '';
  // Strip note in parens, asterisks
  const ans = answerText.replace(/\([^)]*\)/g, '').trim();
  // Take short keywords from question (remove common stop words)
  let qShort = q.q.replace(/[?\.,\'"!:;]/g, ' ');
  // Remove generic stop phrases
  qShort = qShort
    .replace(/^(Which of the following|What is|Who is|Who was|Which|What|Where|When|Why|How)\s+/i, '')
    .replace(/\b(the following|the|a|an|of|in|on|at|to|for|is|are|was|were|do|does|did|can|could)\b/gi, ' ')
    .replace(/\s+/g, ' ').trim()
    .slice(0, 80);
  const query = (ans + ' ' + qShort).trim();
  return 'https://www.google.com/search?tbm=isch&q=' + encodeURIComponent(query);
}

