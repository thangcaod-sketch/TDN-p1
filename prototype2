        <div class="ov-label">Đã thuộc</div>
        <div class="ov-value big">${totMastered}<span style="color:var(--muted);font-size:0.4em;font-weight:400"> / ${totQ}</span></div>
        <div class="ov-sub" style="color:#2D5A4F">${fmtPct(totQ ? totMastered/totQ : 0)}</div>
      </div>
      <div class="card big">
        <div class="ov-label">Độ chính xác</div>
        <div class="ov-value">${totalAns ? fmtPct(accuracy) : "—"}</div>
        <div class="ov-sub">${totalAns} lượt trả lời</div>
