      <div class="card big">
        <div class="ov-label">Tốc độ TB</div>
        <div class="ov-value">${totalAns ? fmtSec(avgSec) : "—"}</div>
        <div class="ov-sub" style="color:#3D4F8C">mỗi câu</div>
      </div>
    </section>
    
    <div class="section-title">
