function startBoss(subject) {
  const target = state.bossTarget || 5;
  const questions = shuffle(answerableQuestions(subject));
  if (questions.length === 0) { alert("Không đủ câu cho môn này."); return; }
  state.boss = {
    subject, target,
    streak: 0, bestStreak: 0,
    lives: 3, idx: 0,
    questions, qStart: Date.now(), startTs: Date.now(),
    selected: null, revealed: false,
    history: [],
    finished: false, won: false,
  };
  go({ name: "boss-stage" });
}

function renderBossStage() {
  const b = state.boss;
  const info = SUBJECTS[b.subject];
  
  if (b.finished) {
    const minutes = ((Date.now() - b.startTs) / 60000).toFixed(1);
    return `
      <div class="boss-stage">
        <div class="result-eyebrow" style="color:${b.won ? '#2D5A4F' : '#B8552E'}">${b.won ? 'CHIẾN THẮNG' : 'HẾT MẠNG'}</div>
        <div class="boss-streak" style="color:${b.won ? '#2D5A4F' : '#B8552E'}">${b.won ? '🏆' : '💀'}</div>
        <div class="result-verdict" style="margin-top:8px">${b.won ? `Trả lời đúng ${b.target} câu liên tiếp!` : `Streak cao nhất: ${b.bestStreak}/${b.target}`}</div>
      </div>
      <div class="overview-grid">
        <div class="card"><div class="ov-label">Streak cao nhất</div><div class="ov-value">${b.bestStreak}<span style="color:var(--muted);font-size:0.4em;font-weight:400"> / ${b.target}</span></div></div>
        <div class="card"><div class="ov-label">Mạng còn</div><div class="ov-value">${b.lives}<span style="color:var(--muted);font-size:0.4em;font-weight:400"> / 3</span></div></div>
        <div class="card"><div class="ov-label">Thời gian</div><div class="ov-value">${minutes}p</div></div>
      </div>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px">
        <button class="btn-primary" style="background:${info.color}" data-action="boss-config" data-subject="${b.subject}">Chơi lại →</button>
        <button class="btn-ghost" data-action="home">Về trang chủ</button>
      </div>
    `;
  }
  
  const q = b.questions[b.idx];
  const optsHtml = q.o.map(o => {
    const [letter, text, note] = o;
    let cls = "option";
    if (b.revealed) {
      if (letter === q.c) cls += " correct";
      else if (letter === b.selected) cls += " wrong";
      else cls += " dim";
    }
    const mark = b.revealed ? (letter === q.c ? "✓" : (letter === b.selected ? "✕" : "")) : "";
    return `
      <button class="${cls}" data-action="boss-pick" data-letter="${letter}" ${b.revealed ? "disabled" : ""}>
        <div class="option-letter">${letter}</div>
        <div class="option-text">${escapeHtml(text)}${note ? `<div class="option-note">(${escapeHtml(note)})</div>` : ""}</div>
        ${mark ? `<div class="option-mark">${mark}</div>` : ""}
      </button>
    `;
  }).join("");
  
  let feedback = "";
  if (b.revealed) {
    const isCorrect = b.selected === q.c;
    const correctOpt = q.o.find(o => o[0] === q.c);
    feedback = `
      <div class="feedback">
        <div class="feedback-text">
          <div class="feedback-title" style="color:${isCorrect ? '#2D5A4F' : '#B8552E'}">${isCorrect ? `Streak: ${b.streak}!` : "Reset streak. Mất 1 mạng!"}</div>
          ${!isCorrect ? `<div class="feedback-sub">Đáp án đúng: <b>${q.c}</b>. ${escapeHtml(correctOpt ? correctOpt[1] : "")}</div>` : ""}
        </div>
        <button class="btn-primary" style="background:${info.color}" data-action="boss-next">Tiếp →</button>
      </div>
    `;
  }
  
  const hearts = [1,2,3].map(i => `<span class="boss-heart${i > b.lives ? ' lost' : ''}">${i > b.lives ? '🤍' : '❤️'}</span>`).join("");
  
  return `
    <div class="boss-stage">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <span class="tag" style="background:${info.soft};color:${info.color}">${info.label} · Boss Mode</span>
        <button class="nav-link" data-action="exit-boss">Thoát</button>
      </div>
      <div class="boss-streak" style="color:${info.color}">${b.streak}<span style="font-size:0.4em;color:var(--muted)"> / ${b.target}</span></div>
      <div class="boss-streak-label">Câu đúng liên tiếp</div>
      <div class="boss-lives">${hearts}</div>
    </div>
    <div class="question-card" style="margin-top:24px">
      <div class="q-eyebrow">Đề ${q.e} · Câu ${q.eq}</div>
      <div class="q-text">${escapeHtml(q.q)}</div>
      ${q.img ? `<div class="q-image-desc" style="background:${info.soft};color:${info.color}">📷 ${escapeHtml(q.img)}</div>` : ""}
      <a class="img-search-btn" href="${imgSearchUrl(q)}" target="_blank" rel="noopener">
        <span>🔍</span> Xem hình minh hoạ trên Google
      </a>
    </div>
    <div class="options-grid">${optsHtml}</div>
    ${feedback}
  `;
}

function bossPick(letter) {
  const b = state.boss;
  if (b.revealed) return;
  b.selected = letter;
  b.revealed = true;
  const q = b.questions[b.idx];
  const isCorrect = letter === q.c;
  const timeMs = Date.now() - b.qStart;
  if (q.c) recordAnswer(q.id, isCorrect, timeMs);
  if (isCorrect) {
    b.streak += 1;
    if (b.streak > b.bestStreak) b.bestStreak = b.streak;
    if (b.streak >= b.target) { b.finished = true; b.won = true; }
  } else {
    b.streak = 0;
    b.lives -= 1;
    if (b.lives <= 0) { b.finished = true; b.won = false; }
  }
  render();
}

function bossNext() {
  const b = state.boss;
  if (b.finished) return;
  b.idx = (b.idx + 1) % b.questions.length;
  b.selected = null; b.revealed = false; b.qStart = Date.now();
  render();
}

// ============================================================
// FLASHCARDS
// ============================================================
function renderFlashcardHome() {
  // Group by topic
  const byTopic = {};
  for (const f of FLASHCARDS) {
    (byTopic[f.topic] = byTopic[f.topic] || []).push(f);
  }
  const topics = Object.entries(byTopic).map(([topic, cards]) => {
    const subj = cards[0].subject;
    const info = SUBJECTS[subj];
    let seen = 0, learned = 0, dueNow = 0;
    const now = Date.now();
    cards.forEach(c => {
      const st = state.progress.fcStats[c.id];
      if (st) {
        seen++;
        if (st.interval >= 7) learned++;
        if (!st.dueAt || st.dueAt <= now) dueNow++;
      } else dueNow++;
    });
    return { topic, cards, subj, info, seen, learned, dueNow };
  });
  
  return `
    <div style="margin-bottom:28px">
      <div class="result-eyebrow" style="color:#9B6B1E">Vocabulary</div>
      <h1 class="sh-title" style="margin:8px 0">Flashcard từ vựng</h1>
      <p style="color:var(--soft-muted)">${FLASHCARDS.length} từ vựng theo 8 chủ đề từ Đề 6-9. Lật thẻ, tự đánh giá độ thuộc, tự lên lịch ôn.</p>
    </div>
    <div class="fc-topic-grid">
      ${topics.map(t => `
        <button class="card lift fc-topic" data-action="fc-topic" data-topic="${escapeHtml(t.topic)}">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px">
            <div class="sc-icon" style="background:${t.info.soft};color:${t.info.color}">${t.info.icon}</div>
            ${t.dueNow > 0 ? `<span class="mode-badge" style="background:${t.info.soft};color:${t.info.color}">${t.dueNow} đến hạn</span>` : ""}
          </div>
          <div class="fc-topic-title">${escapeHtml(t.topic)}</div>
          <div class="fc-topic-meta">${t.cards.length} từ · ${t.seen} đã thấy · ${t.learned} thuộc</div>
        </button>
      `).join("")}
    </div>
  `;
}

function startFlashcardTopic(topic) {
  const cards = FLASHCARDS.filter(f => f.topic === topic);
  // Priority: due first, then unseen, then others
  const now = Date.now();
  const due = [], unseen = [], rest = [];
  for (const c of cards) {
    const st = state.progress.fcStats[c.id];
    if (!st) unseen.push(c);
    else if (!st.dueAt || st.dueAt <= now) due.push(c);
    else rest.push(c);
  }
  const queue = [...shuffle(due), ...shuffle(unseen), ...shuffle(rest)];
  state.fcSession = {
    topic, queue, idx: 0, side: "front", direction: "en2vi",
  };
  go({ name: "flashcard-stage" });
}

function renderFlashcardStage() {
  const s = state.fcSession;
  if (!s || s.idx >= s.queue.length) {
    return `
      <div class="empty-state">
        <h3>Hoàn thành phiên</h3>
        <p>Đã xem hết flashcard trong chủ đề này. Hẹn gặp lại theo lịch SRS!</p>
        <button class="btn-primary" style="background:#9B6B1E" data-action="flashcard">← Trở về danh sách chủ đề</button>
      </div>
    `;
  }
  const card = s.queue[s.idx];
  const info = SUBJECTS[card.subject];
  const showFront = s.side === "front";
  const front = s.direction === "en2vi" ? card.en : card.vi;
  const back = s.direction === "en2vi" ? card.vi : card.en;
  
  return `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <span class="tag" style="background:${info.soft};color:${info.color}">${escapeHtml(card.topic)}</span>
      <div style="display:flex;gap:16px;align-items:center">
        <span class="quiz-counter">${s.idx+1}/${s.queue.length}</span>
        <button class="nav-link" data-action="fc-flip-direction">${s.direction === "en2vi" ? "Anh → Việt" : "Việt → Anh"}</button>
        <button class="nav-link" data-action="flashcard">Thoát</button>
      </div>
    </div>
    <div class="fc-card" data-action="fc-flip">
      <div class="${showFront ? 'fc-front' : 'fc-back'}">${escapeHtml(showFront ? front : back)}</div>
      <div class="fc-hint">${showFront ? 'Bấm để lật' : 'Đánh giá độ thuộc'}</div>
    </div>
    <div style="text-align:center;margin-top:-8px;margin-bottom:8px">
      <a class="img-search-btn" href="https://www.google.com/search?tbm=isch&q=${encodeURIComponent(card.en)}" target="_blank" rel="noopener">
        <span>🔍</span> Hình ảnh "${escapeHtml(card.en)}"
      </a>
    </div>
    ${!showFront ? `
      <div class="fc-rate">
        <button class="fc-rate-btn" style="border-color:#B8552E;color:#B8552E" data-action="fc-rate" data-rating="again">Lại từ đầu<br><small>< 1 ngày</small></button>
        <button class="fc-rate-btn" style="border-color:#9B6B1E;color:#9B6B1E" data-action="fc-rate" data-rating="hard">Khó<br><small>~1-2 ngày</small></button>
        <button class="fc-rate-btn" style="border-color:#3D4F8C;color:#3D4F8C" data-action="fc-rate" data-rating="good">Ổn<br><small>~3-5 ngày</small></button>
        <button class="fc-rate-btn" style="border-color:#2D5A4F;color:#2D5A4F" data-action="fc-rate" data-rating="easy">Dễ<br><small>~7-14 ngày</small></button>
      </div>
    ` : ""}
  `;
}

function fcFlip() {
  if (!state.fcSession) return;
  state.fcSession.side = state.fcSession.side === "front" ? "back" : "front";
  render();
}

function fcRate(rating) {
  const s = state.fcSession;
  const card = s.queue[s.idx];
  recordFlashcard(card.id, rating);
  s.idx += 1;
  s.side = "front";
  render();
}

// ============================================================
// EVENTS
// ============================================================
function bindEvents() {
  document.querySelectorAll("[data-action]").forEach(el => {
    el.addEventListener("click", e => {
      const a = el.getAttribute("data-action");
      const subj = el.getAttribute("data-subject");
      const mode = el.getAttribute("data-mode");
      
      if (a === "subject") go({ name: "subject", subject: subj });
      else if (a === "start-quiz") startQuiz(mode, subj);
      else if (a === "boss-config") { state.bossTarget = 5; go({ name: "boss-config", subject: subj }); }
      else if (a === "boss-target") { state.bossTarget = parseInt(el.getAttribute("data-n")); render(); }
      else if (a === "boss-start") startBoss(subj);
      else if (a === "boss-pick") bossPick(el.getAttribute("data-letter"));
      else if (a === "boss-next") bossNext();
      else if (a === "exit-boss") { if (confirm("Thoát Boss Mode? Tiến trình streak sẽ mất.")) go({ name: "home" }); }
      else if (a === "dismiss-boss") go({ name: "subject", subject: state.view.subject });
      else if (a === "pick") pickAnswer(el.getAttribute("data-letter"));
      else if (a === "next-q") nextQuestion();
      else if (a === "exit-quiz") { if (confirm("Thoát phiên luyện tập?")) { if (state.session?.timer) clearInterval(state.session.timer); go({ name: "home" }); } }
      else if (a === "weak") go({ name: "weak" });
      else if (a === "stats") go({ name: "stats" });
      else if (a === "flashcard") go({ name: "flashcard-home" });
      else if (a === "fc-topic") startFlashcardTopic(el.getAttribute("data-topic"));
      else if (a === "fc-flip") fcFlip();
      else if (a === "fc-flip-direction") { state.fcSession.direction = state.fcSession.direction === "en2vi" ? "vi2en" : "en2vi"; state.fcSession.side = "front"; render(); }
      else if (a === "fc-rate") fcRate(el.getAttribute("data-rating"));
      else if (a === "home") go({ name: "home" });
      else if (a === "random") startRandomMix();
      else if (a === "reset") { if (confirm("Xoá toàn bộ tiến trình? Hành động này không thể hoàn tác.")) resetAll(); }
    });
  });
}

function startRandomMix() {
  const pool = QUESTIONS.filter(q => q.c);
  const picked = shuffle(pool).slice(0, 10);
  if (picked.length === 0) return;
  // determine dominant subject for color
  state.session = {
    mode: "practice", subject: picked[0].s,
    questions: picked, idx: 0, selected: null, revealed: false,
    answers: [], startTs: Date.now(), qStart: Date.now(),
    isTest: false, timeLeft: null, timer: null,
  };
  go({ name: "quiz" });
}

// ============================================================
// INIT
// ============================================================
loadProgress();
document.getElementById("home-link").addEventListener("click", () => go({ name: "home" }));
document.getElementById("back-link").addEventListener("click", () => go({ name: "home" }));
render();
</script>
