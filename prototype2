      <button class="card lift action-card${weakCount === 0 ? " disabled" : ""}" data-action="weak" ${weakCount === 0 ? "disabled" : ""}>
        <div class="action-icon" style="background:#F4DDD5;color:#B8552E">✕</div>
        <div class="action-text">
