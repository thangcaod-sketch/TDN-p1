// ============================================================
// SUBJECT VIEW
// ============================================================
function renderSubject(subjKey) {
  const info = SUBJECTS[subjKey];
  const stats = computeSubjectStats(subjKey);
  const weak = weakQuestions(subjKey).length;
  const due = dueQuestions(subjKey).length;
  const unseen = stats.total - stats.seen;
  
  const badge = (m) => {
    if (m.id === "srs" && due > 0) return `${due} câu đến hạn`;
    if (m.id === "weak" && weak > 0) return `${weak} câu`;
    if (m.id === "practice" && unseen > 0) return `${unseen} câu mới`;
    return null;
  };
  
  const modeCards = MODES.filter(m => !m.isFlashcard).map(m => {
    const b = badge(m);
    const isBoss = m.id === "boss";
    return `
      <div class="card mode-card">
        <div class="mode-head">
          <div class="mode-title">${m.label}</div>
          ${b ? `<div class="mode-badge" style="background:${info.soft};color:${info.color}">${b}</div>` : ""}
        </div>
        <p class="mode-desc">${m.desc}</p>
        <button class="mode-btn" style="background:${info.color}" data-action="${isBoss?'boss-config':'start-quiz'}" data-mode="${m.id}" data-subject="${subjKey}">
          Bắt đầu →
        </button>
      </div>
    `;
  }).join("");
  
  return `
    <div class="subject-header" style="background:${info.soft};border:1px solid ${info.color}33">
      <div class="sh-flex">
        <div>
          <div class="sh-eyebrow" style="color:${info.color}">${info.en}</div>
          <h1 class="sh-title" style="color:${info.color}">${info.label}</h1>
          <div class="sh-stats">
            <div><b class="num">${stats.total}</b> câu</div>
            <div><b class="num">${stats.seen}</b> đã thấy</div>
            <div><b class="num">${stats.mastered}</b> thuộc</div>
            ${stats.correct + stats.wrong > 0 ? `<div><b class="num">${fmtPct(stats.accuracy)}</b> chính xác</div>` : ""}
          </div>
        </div>
        ${masteryRing(stats.masteryPct, info.color, 88)}
      </div>
    </div>
    <div class="section-title">
      <h2>Chọn chế độ luyện tập</h2>
    </div>
    <div class="mode-grid">${modeCards}</div>
  `;
}

// ============================================================
// QUIZ
// ============================================================
function startQuiz(mode, subject) {
  const questions = pickQuestionsForMode(mode, subject);
  if (questions.length === 0) {
    alert("Không có câu hỏi phù hợp cho chế độ này.");
    return;
  }
  state.session = {
    mode, subject, questions, idx: 0,
    selected: null, revealed: false,
    answers: [], startTs: Date.now(), qStart: Date.now(),
    isTest: mode === "test",
    timeLeft: mode === "test" ? 600 : null,
    timer: null,
  };
  if (state.session.isTest) {
    state.session.timer = setInterval(() => {
      state.session.timeLeft -= 1;
      const el = document.getElementById("timer-display");
      if (el) el.textContent = `⏱ ${Math.floor(state.session.timeLeft/60)}:${String(state.session.timeLeft%60).padStart(2,"0")}`;
      if (state.session.timeLeft <= 0) { clearInterval(state.session.timer); finishQuiz(); }
    }, 1000);
  }
  go({ name: "quiz" });
}

function renderQuiz() {
  const s = state.session;
  const info = SUBJECTS[s.subject];
  const q = s.questions[s.idx];
  const modeLabel = (MODES.find(m => m.id === s.mode) || {}).label || s.mode;
  const progressPct = (s.idx + (s.revealed ? 1 : 0.5)) / s.questions.length;
  
  const optsHtml = q.o.map(o => {
    const [letter, text, note] = o;
    let cls = "option";
    if (s.revealed) {
      if (letter === q.c) cls += " correct";
      else if (letter === s.selected) cls += " wrong";
      else cls += " dim";
    } else if (s.selected === letter) cls += " selected";
    const mark = s.revealed ? (letter === q.c ? "✓" : (letter === s.selected ? "✕" : "")) : "";
    return `
      <button class="${cls}" data-action="pick" data-letter="${letter}" ${s.revealed ? "disabled" : ""} style="${s.selected === letter && !s.revealed ? `border-color:${info.color};background:${info.soft}` : ""}">
        <div class="option-letter" ${s.selected === letter && !s.revealed ? `style="background:${info.color};color:#fff"` : ""}>${letter}</div>
        <div class="option-text">${escapeHtml(text)}${note ? `<div class="option-note">(${escapeHtml(note)})</div>` : ""}</div>
        ${mark ? `<div class="option-mark">${mark}</div>` : ""}
      </button>
    `;
  }).join("");
  
  let feedback = "";
  if (s.revealed) {
    const isCorrect = s.selected === q.c;
    const correctOpt = q.o.find(o => o[0] === q.c);
    feedback = `
      <div class="feedback">
        <div class="feedback-text">
          <div class="feedback-title" style="color:${isCorrect ? '#2D5A4F' : '#B8552E'}">${isCorrect ? "Chính xác!" : "Chưa đúng"}</div>
          ${!isCorrect ? `<div class="feedback-sub">Đáp án đúng: <b>${q.c}</b>. ${escapeHtml(correctOpt ? correctOpt[1] : "")}</div>` : ""}
        </div>
        <button class="btn-primary" style="background:${info.color}" data-action="next-q">${s.idx === s.questions.length - 1 ? "Xem kết quả →" : "Câu tiếp →"}</button>
      </div>
    `;
  }
  
  return `
    <div class="quiz-top">
      <div class="quiz-tags">
        <span class="tag" style="background:${info.soft};color:${info.color}">${info.label}</span>
        <span class="tag-muted">${modeLabel}</span>
      </div>
      <div style="display:flex;gap:18px;align-items:center">
        ${s.isTest ? `<div class="timer" id="timer-display" style="color:${s.timeLeft < 60 ? '#B8552E' : 'inherit'}">⏱ ${Math.floor(s.timeLeft/60)}:${String(s.timeLeft%60).padStart(2,"0")}</div>` : ""}
        <div class="quiz-counter">${s.idx + 1}/${s.questions.length}</div>
        <button class="nav-link" data-action="exit-quiz">Thoát</button>
      </div>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="background:${info.color};width:${progressPct*100}%"></div></div>
    <div class="question-card">
      <div class="q-eyebrow">Đề ${q.e} · Câu ${q.eq}${!q.c ? " · ⚠ Đáp án chưa xác minh" : ""}</div>
      <div class="q-text">${escapeHtml(q.q)}</div>
      ${q.img ? `<div class="q-image-desc" style="background:${info.soft};color:${info.color}">📷 ${escapeHtml(q.img)}</div>` : ""}
      ${q.n ? `<div class="q-note">(${escapeHtml(q.n)})</div>` : ""}
      <a class="img-search-btn" href="${imgSearchUrl(q)}" target="_blank" rel="noopener">
        <span>🔍</span> Xem hình minh hoạ trên Google
      </a>
    </div>
    <div class="options-grid">${optsHtml}</div>
    ${feedback}
  `;
}

function pickAnswer(letter) {
  const s = state.session;
  if (s.revealed) return;
  s.selected = letter;
  const q = s.questions[s.idx];
  const isCorrect = letter === q.c;
  const timeMs = Date.now() - s.qStart;
  s.answers.push({ qId: q.id, selected: letter, correct: isCorrect, timeMs, q });
  if (q.c) recordAnswer(q.id, isCorrect, timeMs);
  if (s.isTest) {
    setTimeout(() => nextQuestion(), 250);
  } else {
    s.revealed = true;
    render();
  }
}

function nextQuestion() {
  const s = state.session;
  if (s.idx === s.questions.length - 1) { finishQuiz(); return; }
  s.idx += 1; s.selected = null; s.revealed = false; s.qStart = Date.now();
  render();
}

function finishQuiz() {
  const s = state.session;
  if (s.timer) clearInterval(s.timer);
  const correct = s.answers.filter(a => a.correct).length;
  const session = {
    ts: Date.now(), subject: s.subject, mode: s.mode,
    total: s.answers.length, correct,
    durationMs: Date.now() - s.startTs,
    answers: s.answers,
  };
  recordSession(session);
  state.session = null;
  go({ name: "result", session });
}

