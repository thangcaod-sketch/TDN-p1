// WEAK
// ============================================================
function renderWeak() {
  const weak = weakQuestions(null);
  if (weak.length === 0) {
    return `<div class="empty-state"><h3>Chưa có câu sai</h3><p>Bạn chưa từng trả lời sai câu nào. Hãy luyện tập tiếp để khu vực này có nội dung!</p></div>`;
  }
  // Group by subject
  const grouped = {};
  weak.forEach(q => { (grouped[q.s] = grouped[q.s] || []).push(q); });
  
  let html = `
    <div style="margin-bottom:28px">
      <div class="result-eyebrow" style="color:#B8552E">Cần dò lại</div>
      <h1 class="sh-title" style="margin:8px 0 8px">Khu vực câu hay sai</h1>
      <p style="color:var(--soft-muted)">${weak.length} câu có tỷ lệ đúng dưới 60% hoặc lần gần nhất trả lời sai.</p>
    </div>
  `;
  for (const subjKey of Object.keys(grouped)) {
    const info = SUBJECTS[subjKey];
    html += `<div class="section-title" style="margin-top:24px"><h2 style="color:${info.color}">${info.label}</h2><button class="btn-primary" style="background:${info.color};padding:7px 14px;font-size:13px" data-action="start-quiz" data-mode="weak" data-subject="${subjKey}">Luyện lại</button></div>`;
    html += grouped[subjKey].map(q => {
      const s = state.progress.qStats[q.id];
      const ratio = s.correct / Math.max(1, s.correct + s.wrong);
      const correctOpt = q.o.find(o => o[0] === q.c);
      return `
        <div class="list-row">
          <span class="tag" style="background:${info.soft};color:${info.color};flex-shrink:0">${info.label}</span>
          <div class="lr-info">
            <div class="lr-meta">Đề ${q.e} · Câu ${q.eq}</div>
            <div class="lr-q">${escapeHtml(q.q)}</div>
            <div class="lr-stats" style="color:var(--muted)">Đáp án đúng: <b style="color:#2D5A4F">${q.c}</b> — ${escapeHtml(correctOpt ? correctOpt[1] : "")}</div>
            <div class="lr-stats" style="color:#B8552E">${s.wrong} sai · ${s.correct} đúng · ${fmtPct(ratio)} chính xác</div>
          </div>
        </div>
      `;
    }).join("");
  }
  return html;
}

